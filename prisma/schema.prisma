generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                 String              @id @default(uuid())
  email              String              @unique
  senha              String
  nomeIgreja         String              // Guarda o Nome da Igreja (se IGREJA/ADMIN) ou Nome do Ministro (se MINISTRO)
  role               String              @default("IGREJA") // "IGREJA", "MINISTRO" ou "ADMIN"
  criadoEm           DateTime            @default(now())
  relatorios         Relatorio[]
  relatoriosConselho RelatorioConselho[]
  relatoriosMinistro RelatorioMinistro[]
}

model Relatorio {
  id                String   @id @default(uuid())
  anoReferencia     Int      @default(2026)
  estruturaDados    Json?
  departamentos     Json?
  rolMembros        Json?
  financeiroPassado Json?
  financeiroFuturo  Json?
  informacoesFinais Json?
  atualizadoEm      DateTime @updatedAt
  criadoEm          DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
}

model RelatorioConselho {
  id                     String   @id @default(uuid())
  anoReferencia          Int      @default(2026)
  identificacao          Json?
  organizacao            Json?
  supervisaoEspiritual   Json?
  supervisaoAdmin        Json?
  planejamentoPatrimonio Json?
  informacoesFinais      Json?
  atualizadoEm           DateTime @updatedAt
  criadoEm               DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@unique([usuarioId, anoReferencia])
}

model RelatorioMinistro {
  id                  String   @id @default(uuid())
  anoReferencia       Int      @default(2026)
  nomeMinistro        String
  identificacaoCampo  Json?
  liderancaPastoral   Json?
  nutricaoEspiritual  Json?
  assistenciaPastoral Json?
  protecaoPastoral    Json?
  outrasInformacoes   Json?
  atualizadoEm        DateTime @updatedAt
  criadoEm            DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
}