generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                 String              @id @default(uuid())
  email              String              @unique
  senha              String
  nomeIgreja         String
  criadoEm           DateTime            @default(now())
  relatorios         Relatorio[]
  relatoriosConselho RelatorioConselho[]
  relatoriosMinistro RelatorioMinistro[] // <-- Nova linha adicionada aqui
}

model Relatorio {
  id                String   @id @default(uuid())
  anoReferencia     Int      @default(2026)
  estruturaDados    Json?
  departamentos     Json?
  rolMembros        Json?
  financeiroPassado Json?
  financeiroFuturo  Json?
  informacoesFinais Json?
  atualizadoEm      DateTime @updatedAt
  criadoEm          DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
}

model RelatorioConselho {
  id                     String   @id @default(uuid())
  anoReferencia          Int      @default(2026)
  identificacao          Json?
  organizacao            Json?
  supervisaoEspiritual   Json?
  supervisaoAdmin        Json?
  planejamentoPatrimonio Json?
  informacoesFinais      Json?
  atualizadoEm           DateTime @updatedAt
  criadoEm               DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@unique([usuarioId, anoReferencia])
}

// <-- Novo bloco adicionado no final do arquivo
model RelatorioMinistro {
  id                  String   @id @default(uuid())
  anoReferencia       Int      @default(2026)
  nomeMinistro        String
  identificacaoCampo  Json?
  liderancaPastoral   Json?
  nutricaoEspiritual  Json?
  assistenciaPastoral Json?
  protecaoPastoral    Json?
  outrasInformacoes   Json?
  atualizadoEm        DateTime @updatedAt
  criadoEm            DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
}